# Copie para .env e ajuste os valores.

# Banco de dados. SQLite por padrao; aceita PostgreSQL, ex.:
# DATABASE_URL=postgresql+psycopg://usuario:senha@localhost:5432/barbearia
DATABASE_URL=sqlite:///./barbearia.db

# Troque por um valor aleatorio e longo em producao.
JWT_SECRET=troque-este-segredo-em-producao
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Fuso horario padrao das barbearias (America/Sao_Paulo, America/Manaus, etc.)
DEFAULT_TIMEZONE=America/Sao_Paulo

# Antecedencia minima (em minutos) para agendar um horario.
MIN_LEAD_MINUTES=15

# Origens liberadas no CORS, separadas por virgula. Use * em desenvolvimento.
CORS_ORIGINS=*

# Cria dados de demonstracao ao iniciar a API (true/false).
SEED_ON_STARTUP=false
